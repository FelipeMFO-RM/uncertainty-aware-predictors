{
  "target_col": "iacs_final",
  "feature_cols": [
    "purity",
    "iacs",
    "temperature",
    "time"
  ],
  "group_col": null,
  "n_folds": 5,
  "random_state": 42,
  "presets": "best_quality",
  "time_limit_a": 300,
  "time_limit_b": 180,
  "eval_metric": "root_mean_squared_error",
  "variance_floor_frac": 0.01,
  "log_space_variance": true,
  "log_epsilon": 1e-06,
  "output_dir": "./annealing_iacs_run"
}